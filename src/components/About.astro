---
import { Image } from 'astro:assets'
import aboutPhoto from '../assets/fotos/5-rafael-j-mejia/3.jpeg'
import communityPhoto from '../assets/fotos/7-robledo-margaritas/2.jpeg'

const audiences = ['Niños', 'Jóvenes', 'Personas mayores', 'Familias desplazadas']
---

<section id="quienes" class="mx-auto max-w-6xl px-4 py-20 md:px-6 md:py-28">
	<div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
		<div>
			<p class="section-kicker">Quiénes somos</p>
			<h2 class="font-display text-4xl font-medium tracking-tight text-brand-navy md:text-5xl">
				Una fundación que teje oportunidades
			</h2>
			<p class="mt-6 text-lg leading-relaxed text-brand-muted">
				Somos una entidad sin ánimo de lucro. Nuestro propósito es ayudar a poblaciones vulnerables en Medellín, el Meta y otras comunidades de Colombia — y también más allá de las fronteras.
			</p>
			<p class="mt-4 text-lg leading-relaxed text-brand-muted">
				Llevamos uniformes, útiles, alimentos, ropa y salidas de bienestar. Cada donación se convierte en un hilo más de dignidad y esperanza.
			</p>
			<ul class="mt-8 flex flex-wrap gap-2">
				{
					audiences.map((item) => (
						<li class="rounded-full border border-brand-navy/8 bg-white px-4 py-2 text-sm font-medium text-brand-navy">
							{item}
						</li>
					))
				}
			</ul>
		</div>
		<div class="relative">
			<Image
				src={aboutPhoto}
				alt="Una niña recibe un kit de aseo de un voluntario en el aula"
				class="relative z-10 w-full rounded-4xl object-cover shadow-card"
			/>
			<div class="absolute -bottom-8 -left-4 z-20 hidden max-w-[220px] overflow-hidden rounded-3xl border-4 border-brand-sand shadow-card md:block">
				<Image src={communityPhoto} alt="Niña sonríe con zapatos nuevos donados por la fundación" class="h-40 w-full object-cover" />
			</div>
			<blockquote class="absolute -right-2 top-8 z-20 hidden max-w-[240px] rounded-2xl border border-brand-navy/8 bg-white p-5 shadow-soft lg:block">
				<p class="font-display text-lg italic leading-snug text-brand-navy">
					«Cada puntada que damos en la comunidad fortalece la autoestima y abre caminos al saber»
				</p>
			</blockquote>
		</div>
	</div>
</section>
