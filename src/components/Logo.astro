---
interface Props {
	variant?: 'light' | 'dark'
	compact?: boolean
}

const { variant = 'dark', compact = false } = Astro.props
const textClass = variant === 'light' ? 'text-white' : 'text-brand-navy'
---

<a href="#inicio" class={`group inline-flex items-center gap-2.5 ${textClass}`} aria-label="Cortejiendo Sueños, ir al inicio">
	<svg
		class={compact ? 'h-9 w-11' : 'h-11 w-14'}
		viewBox="0 0 52 40"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<path
			d="M18 36.2 15.9 34.3C8.7 27.7 4 23.4 4 17.8 4 13.5 7.3 10.2 11.6 10.2c2.4 0 4.7 1.2 6.2 3.1 1.5-1.9 3.8-3.1 6.2-3.1C28.3 10.2 31.6 13.5 31.6 17.8c0 5.6-4.7 9.9-11.9 16.5L18 36.2Z"
			fill="#4AA0E0"
		></path>
		<path
			d="M33.8 33.8 31.7 31.9C24.5 25.3 19.8 21 19.8 15.4c0-4.3 3.3-7.6 7.6-7.6 2.4 0 4.7 1.2 6.2 3.1 1.5-1.9 3.8-3.1 6.2-3.1 4.3 0 7.6 3.3 7.6 7.6 0 5.6-4.7 9.9-11.9 16.5l-2.1 1.9Z"
			fill="#E23C4A"
		></path>
	</svg>
	<span class="leading-none">
		<span class={`block font-display italic tracking-tight ${compact ? 'text-lg' : 'text-xl md:text-2xl'}`}>
			Cortejiendo
		</span>
		<span class={`block font-display font-medium ${compact ? 'text-base' : 'text-lg md:text-xl'} -mt-0.5`}>
			Sueños
		</span>
	</span>
</a>
