---
import { Image } from 'astro:assets'
import logoMark from '../assets/brand/logo-hearts-clean.png'

interface Props {
	variant?: 'light' | 'dark'
	compact?: boolean
}

const { variant = 'dark', compact = false } = Astro.props
const textClass = variant === 'light' ? 'text-white' : 'text-brand-navy'
const markClass = compact ? 'h-10 w-10' : 'h-11 w-11 md:h-12 md:w-12'
---

<a href="#inicio" class={`group inline-flex items-center gap-3 ${textClass}`} aria-label="Cortejiendo Sueños, ir al inicio">
	<Image src={logoMark} alt="" class={`${markClass} shrink-0 object-contain`} aria-hidden="true" />
	<span class="leading-none">
		<span class={`block font-display italic tracking-tight ${compact ? 'text-lg' : 'text-xl md:text-2xl'}`}>
			Cortejiendo
		</span>
		<span class={`block font-display font-medium ${compact ? 'text-base' : 'text-lg md:text-xl'} -mt-0.5`}>
			Sueños
		</span>
	</span>
</a>
