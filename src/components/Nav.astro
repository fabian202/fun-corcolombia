---
import Logo from './Logo.astro'

const links = [
	{ href: '#quienes', label: 'Quiénes somos' },
	{ href: '#proyectos', label: 'Proyectos' },
	{ href: '#galeria', label: 'Galería' },
	{ href: '#contacto', label: 'Contacto' },
]
---

<header class="sticky top-0 z-50 border-b border-brand-navy/8 bg-brand-sand/95 backdrop-blur-md">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
		<Logo compact />
		<nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="text-sm font-medium text-brand-navy/75 transition hover:text-brand-heart"
					>
						{link.label}
					</a>
				))
			}
			<a
				href="https://wa.me/573136504001"
				class="btn-primary !px-5 !py-2.5"
				target="_blank"
				rel="noopener noreferrer"
			>
				Donar
			</a>
		</nav>
		<div class="flex items-center gap-2 md:hidden">
			<a
				href="https://wa.me/573136504001"
				class="btn-primary !px-4 !py-2 text-xs"
				target="_blank"
				rel="noopener noreferrer"
			>
				Donar
			</a>
			<button
				id="menu-toggle"
				class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-brand-navy/10 text-brand-navy"
				type="button"
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Abrir menú"
			>
				<svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
				<svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
		</div>
	</div>
	<div id="mobile-menu" class="hidden border-t border-brand-navy/8 bg-brand-sand px-4 py-4 md:hidden">
		<nav class="flex flex-col gap-2" aria-label="Móvil">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="rounded-xl px-3 py-3 text-base font-medium text-brand-navy transition hover:bg-white"
						data-mobile-link
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle')
	const menu = document.getElementById('mobile-menu')
	const iconOpen = document.getElementById('icon-open')
	const iconClose = document.getElementById('icon-close')
	const links = document.querySelectorAll('[data-mobile-link]')

	const setOpen = (open: boolean) => {
		if (!toggle || !menu || !iconOpen || !iconClose) return
		toggle.setAttribute('aria-expanded', String(open))
		toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú')
		menu.classList.toggle('hidden', !open)
		iconOpen.classList.toggle('hidden', open)
		iconClose.classList.toggle('hidden', !open)
	}

	toggle?.addEventListener('click', () => {
		const open = toggle.getAttribute('aria-expanded') === 'true'
		setOpen(!open)
	})

	links.forEach((link) => {
		link.addEventListener('click', () => setOpen(false))
	})
</script>
