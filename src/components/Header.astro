---
import { Image } from 'astro:assets'
import hero from '../assets/fotos/5-rafael-j-mejia/2.jpeg'
---

<section id="inicio" class="relative isolate min-h-[90vh] overflow-hidden">
	<Image
		src={hero}
		alt="Niña sonríe en el aula durante una jornada de Cortejiendo Sueños en Medellín"
		class="absolute inset-0 h-full w-full max-w-none object-cover object-[70%_35%] md:object-[65%_30%]"
		loading="eager"
	/>
	<div class="absolute inset-0 bg-gradient-to-r from-brand-navy via-brand-navy/75 to-brand-navy/15"></div>
	<div class="absolute inset-0 bg-gradient-to-t from-brand-navy/90 via-brand-navy/10 to-transparent"></div>

	<div class="relative mx-auto flex min-h-[90vh] max-w-6xl flex-col justify-end px-4 pb-16 pt-28 md:px-6 md:pb-24">
		<p class="section-kicker text-white/80">Fundación · Colombia</p>
		<h1 class="max-w-3xl font-display text-4xl font-medium leading-[1.02] tracking-tight text-white sm:text-6xl md:text-7xl">
			Tejemos sueños con <em class="italic text-brand-heart">corazón</em>
		</h1>
		<p class="mt-6 max-w-xl text-base leading-relaxed text-white/85 md:text-lg">
			Acompañamos a niños, jóvenes, personas mayores y familias desplazadas con educación, alimentos, ropa y momentos de alegría.
		</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<a href="#proyectos" class="btn-primary">Conoce los proyectos</a>
			<a href="#galeria" class="btn-secondary">Ver la galería</a>
		</div>
	</div>
</section>
